# Local demo only. Do not collect or solicit real payments in demo mode.
DEMO_MODE=1
ADMIN_PASSWORD=change-me-in-production
SESSION_SECRET=local-demo-secret-change-before-deploy
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data

# LIVE: Set the following only after written approval of the organizer, raffle,
# required permits, and payment-processing category. Never misclassify the business.
ENABLE_LIVE_PAYMENTS=0
RAFFLE_LEGAL_APPROVED=0
PROCESSOR_APPROVED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional receipt email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
